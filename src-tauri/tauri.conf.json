{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Captnz Board",
  "version": "1.0.0",
  "identifier": "com.captnz.board",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Captnz Board",
        "width": 1920,
        "height": 1080,
        "minWidth": 960,
        "minHeight": 600,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "fileAssociations": [
      {
        "ext": ["cboard"],
        "name": "Captnz Board Project",
        "description": "Captnz Board Editable Whiteboard Project",
        "role": "Editor",
        "mimeType": "application/x-captnz-board"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": ["pptx", "ppt"],
        "name": "PowerPoint Presentation",
        "description": "Microsoft PowerPoint Presentation",
        "role": "Viewer"
      },
      {
        "ext": ["png", "jpg", "jpeg"],
        "name": "Image File",
        "description": "Image for Whiteboard Annotation",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/caption-ajuz/Captainz-board/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_SIGNING_PUBLIC_KEY"
    }
  }
}
